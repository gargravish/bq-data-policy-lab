# ============================================================================
# CUSTOMER BOILERPLATE CONFIGURATION (.env.example)
# Copy this file to .env and replace with your Google Cloud project & principals:
#   cp .env.example .env
# ============================================================================

# 1. Google Cloud Project, Region, & BigQuery Dataset
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BQ_LOCATION=us-central1
BQ_DATASET=data_policies_example

# 2. Data Catalog Taxonomy & Custom Masking Routine Names
TAXONOMY_DISPLAY_NAME=CustomerGovernanceTaxonomy
ROUTINE_ID=fn_salted_sha256

# 3. Secret Pepper for Salted SHA-256 Custom Masking Routine (Priority #1)
# Prevents rainbow-table dictionary attacks on sequential Primary/Foreign Keys
SECRET_PEPPER=REPLACE_WITH_YOUR_ENTERPRISE_SECRET_PEPPER_2026

# 4. Optional Human / Group Principals for the 3 Core Personas
# (The provisioning script also creates dedicated impersonated Service Accounts
#  dp-persona-admin, dp-persona-testuser, dp-persona-test2, dp-persona-sha256,
#  dp-persona-defaultpk, and dp-persona-conflict automatically in your project)
ADMIN_USER_EMAIL=data-governance-admin@your-company.com
ANALYST_USER_EMAIL=lead-data-scientist@your-company.com
AUDITOR_USER_EMAIL=external-auditor@your-company.com

# 5. Local Workbench Server Bind Settings
HOST=127.0.0.1
PORT=8088
